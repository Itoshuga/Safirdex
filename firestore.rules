rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.roles is list && request.auth.token.roles.hasAny(['admin']))
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /cards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Consultation counters are aggregated exclusively by the trusted server.
    match /cardViews/{cardId} {
      allow read, write: if false;
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sets/{setId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rarities/{rarityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cardTypes/{cardTypeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /factions/{factionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deck reads and every deck mutation go through the authenticated server
    // layer. This prevents private snapshots and author UIDs from leaking to
    // untrusted clients; ownership and legality are rechecked server-side.
    match /decks/{deckId} {
      allow read, write: if false;
    }

    match /glossaryEntries/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public delivery and all editorial mutations go through the server layer.
    // This prevents clients from reading drafts or future scheduled articles.
    match /patchNotes/{patchNoteId} {
      allow read, write: if false;
    }

    // Application-wide operational settings are read and changed exclusively
    // through the trusted server layer after validating the admin claim.
    match /appConfig/{configId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      match /collection/{cardId} {
        allow read: if isOwner(userId);
        // Quantities, counters, activities and public trade projections must
        // stay atomic, so every mutation goes through an authenticated action.
        allow write: if false;
      }

      match /stats/{statsId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /following/{targetId} {
        allow read, write: if false;
      }

      match /followers/{followerId} {
        allow read, write: if false;
      }
    }

    match /publicProfiles/{userId} {
      allow read, write: if false;
    }

    // Safe public trade projections are delivered by the trusted server only.
    // Private collection documents and Discord consent are never client-readable.
    match /cardTrades/{tradeId} {
      allow read, write: if false;
    }

    match /communityActivities/{activityId} {
      allow read, write: if false;
    }

    // Posts are validated, authorized and fanned out by authenticated Server
    // Actions. Direct reads would bypass follower-only visibility checks.
    match /communityPosts/{postId} {
      allow read, write: if false;
    }

    match /userFeeds/{userId} {
      allow read, write: if false;

      match /items/{activityId} {
        allow read, write: if false;
      }
    }

    match /usernames/{key} {
      allow read, write: if false;
    }

    match /pseudonyms/{key} {
      allow read, write: if false;
    }

    match /displayNames/{key} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
