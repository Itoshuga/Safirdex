rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.roles is list && request.auth.token.roles.hasAny(['admin']))
      );
    }

    match /cards/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seasons/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rarities/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /card-types/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId}/avatar.webp {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/banner.webp {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
